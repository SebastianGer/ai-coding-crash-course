{
  "env": {
    "SSH_AUTH_SOCK": ""
  },
  "permissions": {
    "deny": [
      "Bash(git push *git@*)",
      "Bash(git push *ssh://*)",
      "Bash(git remote add *git@*)",
      "Bash(git remote add *ssh://*)",
      "Bash(git remote set-url *git@*)",
      "Bash(git remote set-url *ssh://*)",
      "Bash(git config *git@*)",
      "Bash(git config *ssh://*)",
      "Bash(*SSH_AUTH_SOCK=*)",
      "NotebookEdit", 
      "DesignSync", 
      "CronCreate", 
      "CronDelete", 
      "CronList", 
      "EnterPlanMode", 
      "ExitPlanMode", 
      "PushNotification", 
      "RemoteTrigger",
      "ReportFindings", 
      "ScheduleWakeup",
      "AskUserQuestion",
      "SendFeedback",
      "ShareOnboardingGuide"
    ]
  },
    "disableClaudeAiConnectors": true,
    "disableWorkflows": true,
    "disableBundledSkills": true,
    "disableArtifact": true,
    "statusLine": {
        "type": "command",
        "command": "npx ccstatusline@latest"
    }
}
